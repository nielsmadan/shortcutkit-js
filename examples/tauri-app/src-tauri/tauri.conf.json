{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShortcutKit Example",
  "version": "0.0.0",
  "identifier": "io.quantumcraft.shortcutkit.example",
  "build": {
    "beforeDevCommand": "pnpm vite",
    "devUrl": "http://127.0.0.1:43173",
    "beforeBuildCommand": "pnpm vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ShortcutKit Example",
        "width": 900,
        "height": 700,
        "visible": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
